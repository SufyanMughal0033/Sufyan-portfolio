# EmailJS credentials — https://www.emailjs.com/
# Copy this file to .env and fill in your own values. Never commit .env.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Optional: separate template for the "Get Free Quote" enquiry modal.
# If not set, the same VITE_EMAILJS_TEMPLATE_ID above will be reused.
VITE_EMAILJS_QUOTE_TEMPLATE_ID=your_quote_template_id
